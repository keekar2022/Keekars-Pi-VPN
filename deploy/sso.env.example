# Concept: Mukesh Kesharwani
# Contact: mukesh.kesharwani@adobe.com
#
# Copy to /etc/pi-config-ui/sso.env, fill in real values, then:
#   sudo chown pi-config-ui:pi-config-ui /etc/pi-config-ui/sso.env
#   sudo chmod 600 /etc/pi-config-ui/sso.env
# Never commit the populated file.

SSO_ISSUER=https://sso.keekar.au
# Authentik application slug (from the app's URL under sso.keekar.au), used
# to build the per-application discovery URL — not the same field as the
# client ID even when the two values happen to match.
SSO_APPLICATION_SLUG=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://vpn.bpl.keekar.au/auth/callback

# Generate with: openssl rand -hex 32
SESSION_SECRET=
