# Concept: Mukesh Kesharwani
# Contact: mukesh.kesharwani@adobe.com
#
# Template for /etc/pi-config-ui/telemetry.env (mode 0600, owned by
# pi-config-ui). Read by deploy/pi-telemetryd.service; see app/telemetry.py.
# Never commit real credentials here.
#
# TELEMETRY_MQTT_HOST must be an address the device can actually reach:
#   - a device on the same LAN as the broker uses its LAN address
#   - a device reachable only over WireGuard uses the broker's address on a
#     subnet inside that tunnel's AllowedIPs
# Pick the address BEFORE deploying — getting this wrong only breaks
# telemetry, but changing tunnel routing to fix it afterwards is exactly
# the kind of change that has caused an SSH lockout on this project.
TELEMETRY_MQTT_HOST=192.168.2.201
TELEMETRY_MQTT_PORT=1883
TELEMETRY_MQTT_USERNAME=CHANGEME
TELEMETRY_MQTT_PASSWORD=CHANGEME

# Defaults to the hostname; set only to override the name shown in Home
# Assistant.
#TELEMETRY_DEVICE_ID=
#TELEMETRY_DEVICE_NAME=

# Comma-separated interfaces to report TX/RX for. Leave unset to report
# every interface except loopback and container/bridge noise.
TELEMETRY_INTERFACES=wlan0,Syd-Home

TELEMETRY_INTERVAL_S=60
