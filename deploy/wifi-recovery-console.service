# Concept: Mukesh Kesharwani
# Contact: mukesh.kesharwani@adobe.com
#
# The actual interactive Wi-Fi recovery console — split out from
# wifi-recovery-check.service (the gate) specifically so that TTYPath
# ownership of tty1 is only ever set up AFTER getty@tty1.service has been
# fully, synchronously stopped by the gate first. Never enabled; only ever
# started explicitly via `systemctl start wifi-recovery-console.service`
# from maintenance.sh's cmd_wifi_recovery_check, which blocks until this
# unit's ExecStart (maintenance.sh's cmd_wifi_recovery_console — see
# docs/RUNBOOK.md §1b) exits.
#
# TTYPath/StandardInput=tty (not a bare ExecStart with shell redirection
# to /dev/tty1) is deliberate: whiptail's ncurses UI needs a real
# controlling-terminal session for keyboard input to work, the same
# mechanism getty@.service itself uses — plain file-descriptor redirection
# in a script is not sufficient for that.

[Unit]
Description=Keekar's Pi VPN - physical console Wi-Fi recovery (console)

[Service]
Type=oneshot
User=root
Group=root
Environment=TERM=linux
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/opt/pi-config-ui/maintenance.sh wifi-recovery-console
